import FWCore.ParameterSet.Config as cms

def customizeForAlpakaSplitter(process):
    print("Customizing process for HelperSplitter")
    
    # Load necessary producers (if not already loaded)
    process.load("RecoLocalCalo.CaloTowersCreator.calotowermaker_cfi")
    process.load("RecoJets.JetProducers.ak4CaloJets_cfi")
    
    # Create Tasks and Paths for CaloTowers and ak4CaloJets if they don't exist
    if not hasattr(process, "towerMakerTask"):
        process.towerMakerTask = cms.Task(process.calotowermaker)
        process.towerMaker_step = cms.Path(process.towerMakerTask)
    if not hasattr(process, "ak4CaloJetsTask"):
        process.ak4CaloJetsTask = cms.Task(process.ak4CaloJets)
        process.ak4CaloJets_step = cms.Path(process.ak4CaloJetsTask)
    
    print("Loaded calotowermaker and ak4CaloJets. Their paths are defined.")

    # Define the HelperSplitter producer.
    # Use the InputTag "ak4CaloJets" without forcing a process name unless required.
    process.HelperSplitter = cms.EDProducer("HelperSplitter",
        Candidate = cms.InputTag("ak4CaloJets"),
        SiPixelClusters = cms.InputTag("SiPixelClusters"),
        ptMin = cms.double(0.5),
        tanLorentzAngle = cms.double(0.1),
        tanLorentzAngleBarrelLayer1 = cms.double(0.2),
        verbose = cms.bool(False)
    )

    # Create a Task and Path for HelperSplitter.
    process.HelperSplitterTask = cms.Task(process.HelperSplitter)
    process.HelperSplitter_step = cms.Path(process.HelperSplitterTask)
    
    print("Defined HelperSplitter and its path.")

    # Instead of replacing the schedule, extend the existing schedule.
    if hasattr(process, "schedule"):
         process.schedule.extend([process.towerMaker_step, process.ak4CaloJets_step, process.HelperSplitter_step])
    else:
         process.schedule = cms.Schedule(process.towerMaker_step, process.ak4CaloJets_step, process.HelperSplitter_step)
    
    print("Extended the process schedule with new paths.")
    
    return process
